# CareConnect backend configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/careconnect
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional external AI provider. Leave blank to use deterministic fallback AI.
AI_API_KEY=
AI_DIAGNOSIS_ENABLED=true
AI_IMAGE_ANALYSIS_ENABLED=true
AI_PRICE_ESTIMATION_ENABLED=true

# Optional Cloudinary evidence storage. Leave blank for authenticated local uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set true for isolated demos/tests without a local MongoDB service.
USE_MEMORY_DB=false

# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional invoice tax rate.
INVOICE_TAX_RATE=0.05
